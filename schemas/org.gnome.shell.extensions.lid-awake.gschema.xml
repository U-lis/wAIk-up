<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.lid-awake"
          path="/org/gnome/shell/extensions/lid-awake/">
    <key name="active" type="b">
      <default>false</default>
      <summary>깨어 있기 활성 상태</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default><![CDATA[['<Super><Shift>l']]]></default>
      <summary>깨어 있기 토글 단축키</summary>
    </key>
    <key name="keep-screen-on" type="b">
      <default>false</default>
      <summary>활성 시 화면도 끄지 않음</summary>
    </key>
    <key name="blank-on-lid-close" type="b">
      <default>true</default>
      <summary>덮개를 닫으면 화면만 끔</summary>
    </key>
    <key name="restore-state" type="b">
      <default>false</default>
      <summary>로그인 시 이전 상태 복원</summary>
    </key>
    <key name="saved-state" type="s">
      <default>'{}'</default>
      <summary>원래 전원 설정 백업(JSON)</summary>
    </key>
  </schema>
</schemalist>
